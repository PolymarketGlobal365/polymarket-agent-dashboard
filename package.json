  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.2",
    "@remotion/bundler": "^4.0.451",
    "@remotion/google-fonts": "^4.0.451",
    "@remotion/renderer": "^4.0.451",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "exceljs": "^4.4.0",
    "playwright": "^1.52.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remotion": "^4.0.451",
    "viem": "^2.38.6"
