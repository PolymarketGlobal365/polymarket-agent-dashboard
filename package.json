{
  "name": "polymarketnow-card-news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily Polymarket homepage crawler and Instagram card news generator",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "autotrade:link-user": "node dist/autotrade-link-user.js",
    "forecast:dashboard": "node dist/polymarket-forecast-dashboard.js",
    "generate": "node dist/index.js",
    "reel:render": "node dist/chart-reel-cli.js render",
    "reel:sample": "node dist/chart-reel-cli.js sample",
    "telegram:program-bot": "node dist/telegram-program-bot.js",
    "telegram:trading-bot": "node dist/telegram-polymarket-trading-bot.js",
    "telegram:crypto": "node dist/telegram-crypto.js",
    "telegram:status": "node dist/telegram-polymarket-status.js",
    "telegram:polymarket-x": "node dist/telegram-polymarket-x.js",
    "telegram:whales": "node dist/telegram-polymarket-whales.js",
